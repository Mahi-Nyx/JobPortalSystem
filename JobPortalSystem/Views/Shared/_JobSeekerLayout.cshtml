<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CareerPulse</title>
    <!-- Modern Google Fonts & Bootstrap 5 -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .navbar-seeker {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            padding: 15px 0;
            box-shadow: 0 4px 20px rgba(37, 99, 235, 0.15);
        }

        .navbar-brand-custom {
            font-weight: 700;
            letter-spacing: -0.5px;
            font-size: 1.4rem;
        }

        .nav-link-custom {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #ffffff !important;
                background-color: rgba(255, 255, 255, 0.1);
            }

        .btn-logout {
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: white;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .btn-logout:hover {
                background-color: #ef4444;
                border-color: #ef4444;
                color: white;
            }

        .footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 25px 0;
            margin-top: 60px;
            color: #64748b;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-seeker sticky-top">
        <div class="container">
            <a class="navbar-brand navbar-brand-custom text-white" href="@Url.Action("Dashboard", "JobSeeker")">
                🚀 CareerPulse
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#seekerNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="seekerNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="@Url.Action("Dashboard", "JobSeeker")">📊 Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="@Url.Action("BrowseJobs", "JobSeeker")">🔍 Browse Jobs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="@Url.Action("MyApplications", "JobSeeker")">📄 My Applications</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <span class="text-white-50 fw-medium small d-none d-sm-inline">
                        Welcome, <strong class="text-white">@Session["FullName"]</strong>
                    </span>
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-logout px-3 py-1.5 small">
                        🚪 Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Injection Area -->
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Developed by Mahi</p>
        </footer>
    </div>

    <!-- Sticky Footer -->
    <footer class="footer text-center">
        <div class="container">
            <p class="mb-0 fw-medium">&copy; @DateTime.Now.Year - CareerPulse Job Placement System</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>