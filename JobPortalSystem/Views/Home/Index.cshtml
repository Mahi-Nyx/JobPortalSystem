@{ ViewBag.Title = "Welcome to JobPortal";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

<style>
    .hero-section {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: white;
        padding: 80px 20px;
        border-radius: 16px;
        margin-top: 20px;
    }

    .feature-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 30px;
        height: 100%;
        transition: transform 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-4px);
        }

    .btn-hero-primary {
        background-color: #2563eb;
        color: white;
        font-weight: 600;
        padding: 12px 28px;
        border-radius: 8px;
        text-decoration: none;
    }

    .btn-hero-secondary {
        background-color: transparent;
        color: white;
        border: 1px solid #64748b;
        font-weight: 600;
        padding: 12px 28px;
        border-radius: 8px;
        text-decoration: none;
    }
</style>

<!-- Hero Section -->
<div class="hero-section text-center mb-5">
    <h1 class="display-4 fw-bold mb-3">Connect Top Talent with Leading Employers</h1>
    <p class="lead text-white-50 max-w-2xl mx-auto mb-4" style="max-width: 650px;">
        Streamline your recruitment workflow or find your next career step with our end-to-end application tracking system.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <a href="/Account/Login" class="btn btn-hero-primary">Sign In</a>
        <a href="/Account/Register" class="btn btn-hero-secondary">Create Account</a>
    </div>
</div>

<!-- Features Section -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="feature-card shadow-sm">
            <h4 class="fw-bold mb-2">🔍 Explore Openings</h4>
            <p class="text-muted mb-0">Browse real-time job listings, filter by criteria, and apply instantly with your online profile.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card shadow-sm">
            <h4 class="fw-bold mb-2">📄 Manage Submissions</h4>
            <p class="text-muted mb-0">Track application states from pending review to approval or rejection with real-time feedback.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card shadow-sm">
            <h4 class="fw-bold mb-2">🏢 Employer Portal</h4>
            <p class="text-muted mb-0">Post job vacancies, review incoming candidate portfolios, and manage candidate workflows in one place.</p>
        </div>
    </div>
</div>