@{ 
    ViewBag.Title = "Forgot Password"; 
}

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
        width: 100%;
        padding: 20px 0;
    }

    .auth-card {
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 14px;
        background-color: #ffffff;
        width: 100%;
        max-width: 440px;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    }

    .auth-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        padding: 2rem 1.5rem;
        text-align: center;
    }

    .auth-header h3 {
        color: #ffffff !important;
        font-weight: 700;
        font-size: 1.6rem;
        margin: 0 0 6px 0;
    }

    .auth-header p {
        color: rgba(255, 255, 255, 0.85) !important;
        margin: 0;
        font-size: 0.9rem;
    }

    .form-label-custom {
        font-size: 0.875rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .form-control-custom {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        padding: 0.65rem 1rem;
        font-size: 0.95rem;
    }

    .btn-auth {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        border-radius: 8px;
        padding: 0.75rem;
        font-weight: 600;
        color: white;
    }
</style>

<div class="auth-container">
    <div class="card auth-card border-0">
        <div class="auth-header">
            <h3>Reset Password</h3>
            <p>Enter your email to update your account password</p>
        </div>

        <div class="card-body p-4 p-sm-5">
            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger small py-2 border-0 shadow-sm mb-4" role="alert" style="border-left: 4px solid #dc3545 !important; background-color: #fdf5f6;">
                        <i class="fas fa-exclamation-circle text-danger me-2"></i> @ViewBag.ErrorMessage
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label-custom d-block">Account Email</label>
                    <input type="email" name="email" class="form-control form-control-custom w-100" placeholder="name@example.com" required autocomplete="off" />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label-custom d-block">New Password</label>
                    <input type="password" name="newPassword" class="form-control form-control-custom w-100" placeholder="Enter new password" required autocomplete="new-password" />
                </div>

                <div class="form-group mb-4">
                    <label class="form-label-custom d-block">Confirm New Password</label>
                    <input type="password" name="confirmPassword" class="form-control form-control-custom w-100" placeholder="Re-enter new password" required autocomplete="new-password" />
                </div>

                <button type="submit" class="btn btn-auth w-100 shadow-sm">
                    Reset Password
                </button>
            }
        </div>

        <div class="card-footer text-center py-3 bg-light border-0">
            <a href="@Url.Action("Login", "Account")" class="font-weight-bold text-decoration-none small" style="color: #2a5298;">Back to Login</a>
        </div>
    </div>
</div>